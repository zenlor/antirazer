diff --git a/driver/razerchromacommon.c b/driver/razerchromacommon.c
index 4a0a9bd..3834c8f 100644
--- a/driver/razerchromacommon.c
+++ b/driver/razerchromacommon.c
@@ -1610,3 +1610,60 @@ struct razer_report razer_chroma_misc_set_hyperpolling_wireless_dongle_unpair(un
 
     return report;
 }
+
+/**
+ * Set the action of an onboard mouse button (Naga LH 2020)
+ *
+ * Storage selects the profile: 0x01 is the live profile the mouse runs. Layer
+ * 0x00 is standard, 0x01 Hypershift. The action is <type> <length> <data...>:
+ * 0x02 <mod> <usage> for a keyboard key, 0x0D <mod> <usage> <rate hi> <rate lo>
+ * for autofire (rate = 1000000 / delay in ms).
+ *
+ * The device stores the record in flash; it only becomes active after
+ * razer_chroma_misc_commit().
+ */
+struct razer_report razer_chroma_misc_set_button_action(unsigned char variable_storage, unsigned char button, unsigned char layer, const unsigned char *action, unsigned char action_len)
+{
+    struct razer_report report = get_razer_report(0x02, 0x0C, 0x0A);
+
+    if (action_len > 7)
+        action_len = 7;
+
+    report.arguments[0] = variable_storage;
+    report.arguments[1] = button;
+    report.arguments[2] = layer;
+    memcpy(&report.arguments[3], action, action_len);
+
+    return report;
+}
+
+/**
+ * Get the action of an onboard mouse button (Naga LH 2020)
+ *
+ * The reply is the stored record, starting with the profile, button and layer.
+ */
+struct razer_report razer_chroma_misc_get_button_action(unsigned char variable_storage, unsigned char button, unsigned char layer)
+{
+    struct razer_report report = get_razer_report(0x02, 0x8C, 0x0A);
+
+    report.arguments[0] = variable_storage;
+    report.arguments[1] = button;
+    report.arguments[2] = layer;
+
+    return report;
+}
+
+/**
+ * Apply the stored configuration (commit)
+ *
+ * Without this command a freshly written record waits for the next device
+ * enumeration.
+ */
+struct razer_report razer_chroma_misc_commit(void)
+{
+    struct razer_report report = get_razer_report(0x00, 0xB3, 0x01);
+
+    report.arguments[0] = 0x00;
+
+    return report;
+}
