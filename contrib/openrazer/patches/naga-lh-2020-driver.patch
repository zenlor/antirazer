     return count;
 }
 
+/**
+ * Read device file "button_action"
+ *
+ * Returns the stored record for the button last selected by writing
+ * "<storage> <button> <layer>": 10 bytes <storage> <button> <layer> <type>
+ * <length> <data...>.
+ */
+static ssize_t razer_attr_read_button_action(struct device *dev, struct device_attribute *attr, char *buf)
+{
+    struct razer_mouse_device *device = dev_get_drvdata(dev);
+    struct razer_report request;
+    struct razer_report response = {0};
+    int err;
+
+    mutex_lock(&device->button_action_lock);
+    request = razer_chroma_misc_get_button_action(device->button_action_query[0],
+                                                  device->button_action_query[1],
+                                                  device->button_action_query[2]);
+    mutex_unlock(&device->button_action_lock);
+
+    /*
+     * The LH 2020 only answers mapping reads when the input class follows the
+     * layer argument; 0x02 selects the thumb grid. A zero there gets no answer.
+     */
+    request.arguments[3] = 0x02;
+    request.transaction_id.id = 0x1F;
+
+    err = razer_send_payload(device, &request, &response);
+    if (err)
+        return err;
+
+    memcpy(buf, response.arguments, 10);
+    return 10;
+}
+
+/**
+ * Write device file "button_action"
+ *
+ * 3 bytes <storage> <button> <layer> select the button that reading returns.
+ * 5-10 bytes <storage> <button> <layer> <type> <length> <data...> also store
+ * and apply an action for it. Only storage 0x01 (the live profile) and the
+ * twelve thumb-grid buttons 0x40..0x4B are known to work on this device.
+ */
+static ssize_t razer_attr_write_button_action(struct device *dev, struct device_attribute *attr, const char *buf, size_t count)
+{
+    struct razer_mouse_device *device = dev_get_drvdata(dev);
+    struct razer_report request;
+    struct razer_report response = {0};
+    int err = 0;
+
+    if (count != 3 && (count < 5 || count > 10))
+        return -EINVAL;
+    if ((unsigned char)buf[0] != 0x01)
+        return -EINVAL;
+    if ((unsigned char)buf[1] < 0x40 || (unsigned char)buf[1] > 0x4B)
+        return -EINVAL;
+    if ((unsigned char)buf[2] > 0x01)
+        return -EINVAL;
+
+    mutex_lock(&device->button_action_lock);
+    if (count > 3) {
+        request = razer_chroma_misc_set_button_action((unsigned char)buf[0],
+                                                      (unsigned char)buf[1],
+                                                      (unsigned char)buf[2],
+                                                      (const unsigned char *)&buf[3],
+                                                      count - 3);
+        request.transaction_id.id = 0x1F;
+        err = razer_send_payload(device, &request, &response);
+
+        /* A record only becomes active after an explicit commit. */
+        if (!err) {
+            request = razer_chroma_misc_commit();
+            request.transaction_id.id = 0x1F;
+            err = razer_send_payload(device, &request, &response);
+        }
+    }
+    if (!err)
+        memcpy(device->button_action_query, buf, 3);
+    mutex_unlock(&device->button_action_lock);
+
+    return err ? err : count;
+}
+
