{
  "device": "2014",
  "bindings": {
    "normal": {
      "1": "x",
      "2": "mouse:middle",
      "3": "macro:copy_paste",
      "wheel-up": "pgup",
      "wheel-down": "pgdn"
    }
  },
  "macros": {
    "copy_paste": [
      {"key": "ctrl+c"},
      {"delay": 100},
      {"key": "ctrl+v"}
    ]
  }
}
